# The deploy user's crontab on the VPS (healthspec.md §3). The deploy
# workflow installs it with `crontab /srv/tummy/crontab`, replacing what was there.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Daily database backup to the box and to R2, 03:30 JST.
30 18 * * * /srv/tummy/backup.sh >> /srv/tummy/backups/backup.log 2>&1

# Weekly proof that the newest R2 backup restores, Sunday 04:30 JST.
30 19 * * 6 /srv/tummy/restore-check.sh >> /srv/tummy/backups/backup.log 2>&1

# Food photos nobody reviewed in 30 days. Their drafts keep the reading. Run in
# the app's container, as the user that wrote them.
15 19 * * * cd /srv/tummy && docker compose exec -T app find /data/photos -type f -name '*.jpg' -mtime +30 -delete
