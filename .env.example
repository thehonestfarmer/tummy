# Copy to .env.local and fill in. Never commit the filled-in copy.

# Postgres. TLS is required automatically for any non-local host.
DATABASE_URL=postgres://localhost:5432/tummy

# Signs the session cookie and derives users.pin_hash.
# Changing it invalidates every session and every PIN — re-run `bun run seed`.
SESSION_SECRET=change-me

# Four digits each, must differ. The same PINs as the photo app. Read at seed time only.
BUNNY_PIN=0000
BEAR_PIN=1111

# Where food photos wait for review (healthspec.md §5.3). Defaults to ./data/photos.
# In production this is the mounted volume.
# PHOTO_DIR=/data/photos

# Set to 1 to enable the "become partner" strip outside dev.
# DEV_SESSION_TOOLS=1

# Reads food labels and packs, and picks reference-table rows.
# ANTHROPIC_API_KEY=
# Reads labels alongside Claude while the two are compared (healthspec.md §9).
# GEMINI_API_KEY=
# The model that reads labels (default claude-opus-5), and any models to
# read alongside it in the background for `bun run vision:compare` (default
# none). A gemini-* name goes to Gemini, anything else to Claude.
# HEALTH_VISION_MODEL=claude-opus-5
# HEALTH_VISION_COMPARE=
# The Claude model that matches foods to the reference table (default claude-opus-5).
# HEALTH_TEXT_MODEL=claude-opus-5

# Transcription and quick-log parsing.
# GROQ_API_KEY=
# GROQ_PARSE_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
